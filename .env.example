# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & JWT Auth
# Generate secure keys via: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_64_char_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL + SQLAlchemy)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=career_navigator
# Async URL for FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_navigator
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/career_navigator

# Redis & ARQ Background Worker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Gemini LLM Gateway
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=1
